EXECUTION_MODE=fixture

# Choose one credential source. Leave AWS_PROFILE empty when using the three
# temporary credential values below. Never commit a populated .env file.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_TEMPERATURE=0
BEDROCK_MAX_TOKENS=1200
# Live tests remain opt-in even when credentials are configured.
RUN_BEDROCK_LIVE_TESTS=0
# The 315-run Stage 7 campaign is separately opt-in because it can make
# hundreds of model requests.
RUN_BEDROCK_EVALUATION=0
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
DATA_DIR=./data
CHECKPOINT_DB=./data/runtime.db
