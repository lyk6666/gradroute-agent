{
  "name": "graduation-exception-agent-simulation-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "capture": "node scripts/capture-simulation.mjs",
    "capture:legacy": "node scripts/capture-demo.mjs",
    "render": "npm run render:preview",
    "render:preview": "remotion render src/index.ts SimulationPreview720p output/simulation-ui-only-720p.mp4 --codec=h264 --crf=15 --pixel-format=yuv420p --concurrency=2",
    "render:4k": "remotion render src/index.ts SimulationUIOnly4K output/simulation-ui-only-4k.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --concurrency=2",
    "test": "node --test scripts/tests/*.test.mjs",
    "verify": "node scripts/verify-simulation.mjs",
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.520",
    "@remotion/media": "4.0.520",
    "playwright": "1.62.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.520"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.9.3"
  }
}
